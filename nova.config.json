{
  "project": {
    "name": {
      "title": "Mailmask",
      "slug": "mailmask"
    },
    "description": {
      "short": "Self-hosted disposable email aliases on Cloudflare Workers that forward to your real inbox",
      "long": "Disposable, expiring email aliases for your own domain, powered by Cloudflare Email Routing and Cloudflare Workers. Hand out a different address to every site, forward mail to your real inbox, block or allow senders per alias, and switch off any alias the moment it starts getting spam. Interactive CLI for alias management, validation, and deployment."
    },
    "keywords": [
      "email",
      "email-alias",
      "disposable-email",
      "temporary-email",
      "privacy",
      "cloudflare-workers",
      "email-routing"
    ],
    "legalName": "CBN Ventures LLC",
    "pronouns": "business",
    "platforms": [
      "nodejs",
      "web"
    ],
    "startingYear": 2026,
    "license": "MIT"
  },
  "entities": [
    {
      "name": "CBN Ventures",
      "email": "contact@cbnventures.io",
      "url": "https://www.cbnventures.io/",
      "roles": [
        "author"
      ]
    },
    {
      "name": "Jacky Liang",
      "email": "hello@mrjackyliang.com",
      "url": "https://www.mrjackyliang.com/",
      "roles": [
        "contributor",
        "supporter"
      ]
    }
  ],
  "emails": {
    "bugs": "bugs@cbnventures.io"
  },
  "github": {
    "owner": "cbnventures",
    "repo": "mailmask",
    "topics": [
      "email",
      "email-alias",
      "disposable-email",
      "temporary-email",
      "privacy",
      "cloudflare-workers",
      "email-routing",
      "serverless",
      "typescript"
    ],
    "features": {
      "issues": true,
      "wiki": false,
      "projects": false,
      "discussions": false,
      "sponsorships": true
    },
    "policies": {
      "visibility": "public",
      "defaultBranch": "main",
      "mergeMethods": {
        "merge": true,
        "squash": true,
        "rebase": true
      },
      "mergeCommit": {
        "title": "merge-message",
        "message": "pull-request-title"
      },
      "squashMerge": {
        "title": "commit-or-pull-request-title",
        "message": "commit-messages"
      },
      "autoDeleteHeadBranch": true,
      "autoMerge": false,
      "allowUpdateBranch": false,
      "webCommitSignoffRequired": false
    },
    "security": {
      "vulnerabilityAlerts": true,
      "dependabotSecurityUpdates": false,
      "secretScanning": true,
      "pushProtection": true
    },
    "rulesets": {
      "defaultBranch": {
        "enforcement": "active",
        "blockDeletions": true,
        "blockForcePushes": true,
        "requireLinearHistory": false,
        "requireSignedCommits": true,
        "requirePullRequest": false,
        "requiredStatusChecks": [],
        "requireBranchesToBeUpToDate": false
      }
    },
    "actions": {
      "enabled": true,
      "allowedActions": "all",
      "shaPinningRequired": false,
      "defaultWorkflowPermissions": "read",
      "canApprovePullRequestReviews": false,
      "artifactRetentionDays": 7
    },
    "labels": [
      {
        "name": "bug",
        "color": "d73a4a",
        "description": "Something isn't working"
      },
      {
        "name": "documentation",
        "color": "0075ca",
        "description": "Improvements or additions to documentation"
      },
      {
        "name": "duplicate",
        "color": "cfd3d7",
        "description": "This issue or pull request already exists"
      },
      {
        "name": "enhancement",
        "color": "a2eeef",
        "description": "New feature or request"
      },
      {
        "name": "good first issue",
        "color": "7057ff",
        "description": "Good for newcomers"
      },
      {
        "name": "help wanted",
        "color": "008672",
        "description": "Extra attention is needed"
      },
      {
        "name": "invalid",
        "color": "e4e669",
        "description": "This doesn't seem right"
      },
      {
        "name": "question",
        "color": "d876e3",
        "description": "Further information is requested"
      },
      {
        "name": "wontfix",
        "color": "ffffff",
        "description": "This will not be worked on"
      }
    ],
    "issueTemplate": {
      "bugReportFields": [
        "nodejs"
      ]
    }
  },
  "workflows": [
    {
      "template": "check-sponsor-gated-issues",
      "name": "sponsor-check",
      "triggers": [
        "issue-comment",
        "issues"
      ],
      "runsOn": "ubuntu-latest",
      "timeoutMinutes": 5
    },
    {
      "template": "lock-inactive-issues",
      "name": "lock-inactive",
      "triggers": [
        "schedule-weekly"
      ],
      "runsOn": "ubuntu-latest",
      "timeoutMinutes": 5
    },
    {
      "template": "publish",
      "name": "project",
      "triggers": [
        "tag-push"
      ],
      "runsOn": "ubuntu-latest",
      "timeoutMinutes": 15,
      "build": [
        "./packages/mailmask",
        "./apps/docs"
      ],
      "deploy": [
        {
          "to": "npm",
          "path": "./packages/mailmask"
        },
        {
          "to": "github-packages",
          "path": "./packages/mailmask"
        },
        {
          "to": "cloudflare-pages-docusaurus",
          "path": "./apps/docs"
        }
      ]
    }
  ],
  "urls": {
    "homepage": "https://mailmask.cbnventures.io/",
    "repository": "git+https://github.com/cbnventures/mailmask.git",
    "bugs": "https://github.com/cbnventures/mailmask/issues",
    "license": "https://github.com/cbnventures/mailmask/blob/HEAD/LICENSE",
    "logo": "https://mailmask.cbnventures.io/images/logo.svg",
    "documentation": "https://mailmask.cbnventures.io/",
    "npm": "https://www.npmjs.com/package/mailmask",
    "fundSources": [
      "https://github.com/sponsors/cbnventures",
      "https://www.paypal.com/biz/profile/cbnventures"
    ],
    "privacyPolicy": "https://www.cbnventures.io/privacy/",
    "termsOfUse": "https://www.cbnventures.io/terms/"
  },
  "readme": {
    "badges": [
      "npm-version",
      "npm-downloads",
      "github-release",
      "github-top-language",
      "github-license",
      "funding"
    ]
  },
  "workspaces": {
    "./": {
      "role": "project",
      "policy": "freezable",
      "name": "mailmask-project"
    },
    "./apps/docs": {
      "role": "docs",
      "policy": "freezable",
      "name": "mailmask-docs"
    },
    "./packages/mailmask": {
      "role": "package",
      "policy": "distributable",
      "name": "mailmask"
    }
  },
  "ignoreFiles": {
    "./.gitignore": {
      "bundles": [
        "nova"
      ],
      "patterns": [
        "/assets/",
        "!worker-configuration.d.ts",
        "wrangler.toml",
        "config.json",
        "tail-logs.jsonl",
        "graphify-out/"
      ]
    }
  },
  "agents": [
    "claude-code",
    "codex"
  ],
  "recipes": {
    "github": {
      "sync-actions": {
        "enabled": true
      },
      "sync-features": {
        "enabled": true
      },
      "sync-identity": {
        "enabled": true
      },
      "sync-labels": {
        "enabled": true
      },
      "sync-policies": {
        "enabled": true
      },
      "sync-rulesets": {
        "enabled": true
      },
      "sync-security": {
        "enabled": true
      }
    },
    "license": {
      "update-copyright": {
        "enabled": true
      }
    },
    "miscellaneous": {
      "fix-markdown-tables": {
        "enabled": true
      },
      "remove-operating-system-files": {
        "enabled": true,
        "settings": {
          "linux": {},
          "macos": {
            "appleDouble": true,
            "desktopServicesStore": true
          },
          "windows": {
            "enhancedThumbnailDatabase": true,
            "enhancedVistaThumbnailDatabase": true,
            "thumbnailDatabase": true
          }
        }
      }
    },
    "nova-config": {
      "normalize-order": {
        "enabled": true
      }
    },
    "read-me": {
      "update-badges": {
        "enabled": true
      },
      "update-credits": {
        "enabled": true
      },
      "update-documentation": {
        "enabled": true
      },
      "update-header": {
        "enabled": true
      },
      "update-introduction": {
        "enabled": true
      }
    },
    "package-json": {
      "./": {
        "cleanup": {
          "enabled": true,
          "settings": {
            "removeUnknownKeys": true,
            "reorderKeys": true
          }
        },
        "normalize-artifacts": {
          "enabled": true
        },
        "normalize-bundler": {
          "enabled": true
        },
        "normalize-dependencies": {
          "enabled": true,
          "settings": {
            "pinDependencyVersions": true,
            "pinDevDependencyVersions": true
          }
        },
        "normalize-modules": {
          "enabled": true
        },
        "normalize-tooling": {
          "enabled": true
        },
        "sync-environment": {
          "enabled": true,
          "settings": {
            "trackNodeLtsVersions": true
          }
        },
        "sync-identity": {
          "enabled": true
        },
        "sync-ownership": {
          "enabled": true
        }
      },
      "./apps/docs": {
        "cleanup": {
          "enabled": true,
          "settings": {
            "removeUnknownKeys": true,
            "reorderKeys": true
          }
        },
        "normalize-artifacts": {
          "enabled": true
        },
        "normalize-bundler": {
          "enabled": true
        },
        "normalize-dependencies": {
          "enabled": true,
          "settings": {
            "pinDependencyVersions": true,
            "pinDevDependencyVersions": true
          }
        },
        "normalize-modules": {
          "enabled": true
        },
        "normalize-tooling": {
          "enabled": true
        },
        "sync-environment": {
          "enabled": true,
          "settings": {
            "trackNodeLtsVersions": true
          }
        },
        "sync-identity": {
          "enabled": true
        },
        "sync-ownership": {
          "enabled": true
        }
      },
      "./packages/mailmask": {
        "cleanup": {
          "enabled": true,
          "settings": {
            "removeUnknownKeys": true,
            "reorderKeys": true
          }
        },
        "normalize-artifacts": {
          "enabled": true
        },
        "normalize-bundler": {
          "enabled": true
        },
        "normalize-dependencies": {
          "enabled": true,
          "settings": {
            "pinDependencyVersions": true,
            "pinDevDependencyVersions": true
          }
        },
        "normalize-modules": {
          "enabled": true
        },
        "normalize-tooling": {
          "enabled": true
        },
        "sync-environment": {
          "enabled": true,
          "settings": {
            "trackNodeLtsVersions": true
          }
        },
        "sync-identity": {
          "enabled": true,
          "settings": {
            "description": true,
            "keywords": true
          }
        },
        "sync-ownership": {
          "enabled": true,
          "settings": {
            "homepage": true,
            "bugs": true,
            "author": true,
            "contributors": true,
            "funding": true,
            "repository": true
          }
        }
      }
    }
  },
  "environment": {
    "project": {
      "prefix": "PROJECT_"
    },
    "workspaces": {
      "./": {
        "prefix": "ROOT_",
        "variables": [
          {
            "key": "CLOUDFLARE_API_TOKEN",
            "reach": "local"
          }
        ]
      },
      "./apps/docs": {
        "prefix": "DOCS_"
      },
      "./packages/mailmask": {
        "prefix": "MAILMASK_"
      }
    },
    "workflows": {
      "sponsor-check": {
        "prefix": "SGS_"
      }
    }
  },
  "settings": {
    "lockStepVersioning": true,
    "runWorkspaces": {
      "cache": {
        "enabled": true,
        "directory": "./node_modules/.cache/nova/run-workspaces",
        "scripts": [
          "build",
          "check"
        ]
      },
      "concurrency": {
        "build": 2,
        "check": 2,
        "deploy": 2
      }
    },
    "versionStrategy": "semver"
  }
}
